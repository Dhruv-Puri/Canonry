# ============================================================
#  Canonry — example environment file
#  Copy this file to `.env` (project root) and fill in ONE key.
#  The engine reads keys from the project-root .env only.
#  Keys are NEVER logged, printed or committed.
# ============================================================

# Option A (recommended, generous free tier):
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B (fallback #1): https://console.groq.com/keys
GROQ_API_KEY=

# Option B (fallback #2): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Without any key the product still works end to end: rule-based findings
# always arrive, AI-assisted checks are marked "pending" (never silently
# skipped) and the UI notes where the model would add coverage.
