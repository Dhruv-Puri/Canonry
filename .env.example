# ============================================================
#  Canonry — example environment file
#  Copy this file to `.env` (project root) and fill in ONE key.
#  The engine reads keys from the project-root .env only.
#  Keys are NEVER logged, printed or committed.
# ============================================================

# Option A (recommended, generous free tier):
# Get it at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Option B (fallback #1): https://console.groq.com/keys
GROQ_API_KEY=

# Option B (fallback #2): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Option C (no key, nothing leaves your machine): a local Ollama server
# OLLAMA_URL=http://localhost:11434

# Models are tried in the order Gemini -> Groq -> OpenRouter -> Ollama.
# Free model names change; override any of them without code changes:
# CANONRY_GEMINI_MODEL=gemini-3.1-flash-lite
# 3.1 Flash-Lite stays primary; these free-tier fallbacks are tried in order
# when it is busy, rate-limited, or out of daily requests. Each model has its
# own daily allowance, so an exhausted model does not block the check
# (comma-separated; "off" disables them).
# CANONRY_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.8-flash,gemini-3.6-flash
# Free tiers have per-model RPM limits; 0 disables the local limit.
# CANONRY_GEMINI_RPM=15
# Optional per-model overrides: model:rpm,model:rpm
# CANONRY_GEMINI_RPM_LIMITS=gemini-3.1-flash-lite:15,gemini-3.5-flash-lite:15,gemini-flash-lite-latest:15,gemini-3-flash-preview:5,gemini-3.8-flash:5,gemini-3.6-flash:5
# Seconds to skip a model after a 429/503 before trying it again.
# CANONRY_GEMINI_COOLDOWN_SECONDS=45
# CANONRY_GROQ_MODEL=llama-3.1-8b-instant
# CANONRY_OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
# CANONRY_OLLAMA_MODEL=llama3.1:8b

# Daily AI allowance (free keys run out without warning). Defaults: 5 AI-assisted
# checks per person, 50 per workspace, reset at 00:00 UTC. Failed calls never count.
# CANONRY_AI_DAILY_PER_USER=5
# CANONRY_AI_DAILY_PER_WORKSPACE=50

# Without any key the product still works end to end: rule-based findings
# always arrive, AI-assisted checks are marked "pending" (never silently
# skipped) and the UI notes where the model would add coverage.
